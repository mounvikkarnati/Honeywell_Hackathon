{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app:app", "--reload", "--port", "8000"],
      "justMyCode": true
    },
    {
      "name": "Run data generator",
      "type": "debugpy",
      "request": "launch",
      "module": "generator.main",
      "args": ["--days", "14", "--users", "300", "--service-accounts", "15", "--edge-devices", "15", "--anomaly-rate", "0.02", "--outdir", "./output"],
      "justMyCode": true
    },
    {
      "name": "Run ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.ingest",
      "args": ["--outdir", "./output", "--reset"],
      "justMyCode": true
    }
  ]
}
